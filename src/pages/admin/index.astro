---
import Base from '../../layouts/Base.astro';
import site from '../../data/pilseros.json';
import { BTN_DESIGNS } from '../../lib/types';

const s = site.station;
---

<Base
  full
  title="Registration Station"
  description="The PilserLabs control master — manage every module, banner, SEO and theme, and arm the lab agent."
  activeTab="station"
>
  <main class="station width">
    <h2 style="margin-bottom:28px">
      <span class="mono-label">station&nbsp;/&nbsp;control master</span>
    </h2>

    <div id="gate" class="login-box terminal" hidden>
      <div class="tbar">
        <i class="dot" style="background:#3ee0ff"></i>
        <i class="dot" style="background:#00d9ff"></i>
        <i class="dot" style="background:#ffc24b"></i>
        <span class="tlabel">{s.gateTitle}</span>
      </div>
      <div class="tbody">
        <p style="color:var(--ink-dim);font-size:13px;margin-top:0">
          {s.gateDesc}
        </p>
        <div class="field">
          <label for="pw">{s.gateLabel}</label>
          <input type="password" id="pw" autocomplete="current-password" />
        </div>
        <button class="btn btn-volt" id="unlock">{s.gateBtn}</button>
        <div id="gateErr" class="notice err" hidden style="margin-top:16px"></div>
      </div>
    </div>

    <div id="console" class="console" hidden>
      <div class="notice">
        <i class="status-dot"></i>{s.consoleNotice}
      </div>

      <div class="terminal" style="margin-bottom:26px">
        <div class="tbar">
          <i class="dot" style="background:#3ee0ff"></i>
          <i class="dot" style="background:#00d9ff"></i>
          <i class="dot" style="background:#ffc24b"></i>
          <span class="tlabel">{s.agentTitle}</span>
        </div>
        <div class="tbody">
          <p style="color:var(--ink-dim);font-size:13px;margin-top:0;max-width:720px">
            {s.agentDesc}
          </p>
          <div class="field-row">
            <div class="field">
              <label for="agentKey">{s.agentKeyLabel}</label>
              <div class="agent-keyrow">
                <input type="password" id="agentKey" readonly />
                <button class="btn btn-soft" type="button" id="toggleKey">reveal</button>
              </div>
            </div>
            <div class="field">
              <label>&nbsp;</label>
              <button class="btn btn-volt" type="button" id="copyGuide">
                <svg width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <rect x="5" y="5" width="9" height="9" rx="1" stroke="currentColor" stroke-width="1.4" />
                  <path d="M3 11H2.5A1.5 1.5 0 0 1 1 9.5v-7A1.5 1.5 0 0 1 2.5 1h7A1.5 1.5 0 0 1 11 2.5V3" stroke="currentColor" stroke-width="1.4" />
                </svg>
                {s.agentGuideBtn}
              </button>
            </div>
          </div>
          <p style="color:var(--ink-faint);font-size:11.5px;margin-bottom:0;max-width:720px">
            {s.agentGuideHint}
          </p>
          <p style="color:var(--ink-faint);font-size:11.5px;margin:10px 0 0;max-width:720px">
            guide endpoint: <span class="accent">https://pilserlabs.com/api/agent</span> — the key above is the only auth the agent needs.
          </p>
        </div>
      </div>

      <div class="terminal" style="margin-bottom:26px">
        <div class="tbar">
          <i class="dot" style="background:#3ee0ff"></i>
          <i class="dot" style="background:#00d9ff"></i>
          <i class="dot" style="background:#ffc24b"></i>
          <span class="tlabel">MAIL SERVER // EXTERNAL</span>
        </div>
        <div class="tbody">
          <p style="color:var(--ink-dim);font-size:13px;margin-top:0;max-width:760px">
            Point outbound mail at any external provider (Resend, Mailgun, SMTP…) — it
            originates the email to <span class="accent">info@pilserlabs.com</span> and
            Email Routing delivers it to your inbox. Delivery is logged with
            <span class="accent">sent / rejected / failed</span> status in the activity panel.
          </p>
          <div class="field-row">
            <div class="field">
              <label for="m_provider">provider</label>
              <select id="m_provider">
                <option value="none">none (no external mail)</option>
                <option value="api">http api (resend/mailgun…)</option>
                <option value="smtp">smtp</option>
              </select>
            </div>
            <div class="field">
              <label for="m_to">to (override) — default info@pilserlabs.com</label>
              <input type="text" id="m_to" placeholder="info@pilserlabs.com" />
            </div>
          </div>
          <div id="m_api" class="field-row">
            <div class="field">
              <label for="m_apiUrl">api endpoint (POST json with from,to,subject,text,html)</label>
              <input type="text" id="m_apiUrl" placeholder="https://api.resend.com/emails" />
            </div>
            <div class="field">
              <label for="m_apiKey">api key (Bearer)</label>
              <input type="password" id="m_apiKey" />
            </div>
          </div>
          <div class="field-row">
            <div class="field" id="m_apiFromWrap">
              <label for="m_apiFrom">from address</label>
              <input type="text" id="m_apiFrom" placeholder="PilsérLabs <info@pilserlabs.com>" />
            </div>
            <div class="field">
              <label for="m_from">fallback from email</label>
              <input type="text" id="m_from" placeholder="info@pilserlabs.com" />
            </div>
          </div>
          <div id="m_smtp" class="field-row">
            <div class="field">
              <label for="m_smtpHost">smtp host</label>
              <input type="text" id="m_smtpHost" placeholder="smtp.example.com" />
            </div>
            <div class="field">
              <label for="m_smtpPort">port (465 implicit tls / 587 starttls)</label>
              <input type="number" id="m_smtpPort" placeholder="587" />
            </div>
          </div>
          <div id="m_smtp2" class="field-row">
            <div class="field">
              <label for="m_smtpUser">smtp username</label>
              <input type="text" id="m_smtpUser" />
            </div>
            <div class="field">
              <label for="m_smtpPass">smtp password</label>
              <input type="password" id="m_smtpPass" />
            </div>
          </div>
          <label class="check" id="m_smtpSecureWrap" style="margin-bottom:18px">
            <input type="checkbox" id="m_smtpSecure" />
            implicit TLS (465)
          </label>
          <div class="form-actions" style="margin-top:0">
            <button class="btn btn-volt" type="button" id="mSave">save config</button>
            <button class="btn btn-danger" type="button" id="mClear">disable / clear</button>
            <span class="mono-label" id="mStatus" style="align-self:center"></span>
          </div>
        </div>
      </div>

      <div class="terminal">
        <div class="tbar">
          <i class="dot" style="background:#3ee0ff"></i>
          <i class="dot" style="background:#00d9ff"></i>
          <i class="dot" style="background:#ffc24b"></i>
          <span class="tlabel">{s.controlsTitle}</span>
        </div>
        <div class="tbody">
          <form id="regForm" enctype="multipart/form-data">
            <div class="field-row">
              <div class="field">
                <label for="f_slug">slug (url path) — lowercase, 2-49</label>
                <input type="text" id="f_slug" pattern="[a-z0-9](?:[a-z0-9-]{0,47})" required />
              </div>
              <div class="field">
                <label for="f_kind">kind</label>
                <select id="f_kind">
                  <option value="experiment">experiment</option>
                  <option value="project">project</option>
                  <option value="paper">paper</option>
                </select>
              </div>
            </div>
            <div class="field-row">
              <div class="field">
                <label for="f_status">status</label>
                <select id="f_status">
                  <option value="live">live</option>
                  <option value="draft">draft (hidden from feed)</option>
                  <option value="archived">archived</option>
                </select>
              </div>
              <div class="field">
                <label for="f_btnDesign">enter-button design</label>
                <select id="f_btnDesign">
                  {BTN_DESIGNS.map((d) => <option value={d}>{d}</option>)}
                </select>
              </div>
            </div>

            <div class="field">
              <label for="f_title">banner heading / title</label>
              <input type="text" id="f_title" required />
            </div>
            <div class="field">
              <label for="f_desc">description (shown on the card)</label>
              <textarea id="f_desc"></textarea>
            </div>
            <div class="field">
              <label for="f_tags">tags (comma separated)</label>
              <input type="text" id="f_tags" placeholder="agents, serverless, distributed" />
            </div>

            <div class="field-row">
              <div class="field">
                <label for="f_btnLabel">enter-button label</label>
                <input type="text" id="f_btnLabel" placeholder="open module" />
              </div>
              <div class="field">
                <label for="f_theme">theme colors (JSON hex array — empty = auto)</label>
                <textarea class="code" id="f_theme" placeholder='["#3ee0ff","#00d9ff","#03050b"]'></textarea>
                <div id="themePreview" class="swatches" hidden style="margin-top:6px"></div>
              </div>
            </div>

            <div class="field-row">
              <div class="field">
                <label for="f_seoTitle">seo · title</label>
                <input type="text" id="f_seoTitle" />
              </div>
              <div class="field">
                <label for="f_seoKeywords">seo · keywords</label>
                <input type="text" id="f_seoKeywords" />
              </div>
            </div>
            <div class="field-row">
              <div class="field">
                <label for="f_seoDesc">seo · description</label>
                <textarea id="f_seoDesc"></textarea>
              </div>
              <div class="field">
                <label for="f_seoIndex">seo · indexing</label>
                <label class="check">
                  <input type="checkbox" id="f_seoIndex" checked />
                  allow search engines to index
                </label>
              </div>
            </div>

            <div class="field-row">
              <div class="field">
                <label for="f_bannerFile">banner image (card / og — upload)</label>
                <input type="file" id="f_bannerFile" accept="image/*" />
                <small style="color:var(--ink-faint);font-size:11px" id="bannerCur">no banner set</small>
              </div>
              <div class="field">
                <label for="f_bannerUrl">banner url (remote, optional)</label>
                <input type="url" id="f_bannerUrl" placeholder="https://…/banner.png" />
              </div>
            </div>
            <div id="bannerPreviewWrap" hidden style="margin-bottom:18px">
              <span class="mono-label" style="display:block;margin-bottom:6px">current banner</span>
              <img id="bannerPreview" alt="banner preview" style="max-width:100%;max-height:140px;border:1px solid var(--line-2)" />
            </div>
            <label class="check" style="margin-bottom:18px">
              <input type="checkbox" id="f_clearBanner" />
              clear current banner
            </label>

            <div class="field">
              <label for="f_file">dist archive (.zip of built html/css/js) — <b>required for new modules, optional to replace</b></label>
              <div class="dropzone" id="dz" role="button" tabindex="0">
                <span id="dzLabel">drop the dist zip here, or click to browse</span>
                <input type="file" id="f_file" accept=".zip,application/zip" hidden />
              </div>
            </div>

            <div class="form-actions">
              <button type="submit" class="btn btn-volt" id="submitBtn">create / update</button>
              <button type="button" class="btn btn-soft" id="resetBtn">clear form</button>
              <span id="editMode" class="mono-label" hidden style="align-self:center">editing…</span>
            </div>
            <div id="formState" class="notice" style="margin-top:18px" hidden></div>
          </form>
        </div>
      </div>

      <div class="terminal" style="margin-top:26px">
        <div class="tbar">
          <i class="dot" style="background:#3ee0ff"></i>
          <i class="dot" style="background:#00d9ff"></i>
          <i class="dot" style="background:#ffc24b"></i>
          <span class="tlabel">{s.listTitle}</span>
        </div>
        <div class="tbody">
          <div class="filterbar">
            <div class="chips" id="filterChips"></div>
            <input type="search" id="searchBox" placeholder="search title / slug / tags…" style="max-width:240px" />
          </div>
          <div class="entry-list" id="entries"></div>
          <div id="listState" class="notice" hidden></div>
        </div>
      </div>
      <div class="terminal" style="margin-top:26px">
        <div class="tbar">
          <i class="dot" style="background:#3ee0ff"></i>
          <i class="dot" style="background:#00d9ff"></i>
          <i class="dot" style="background:#ffc24b"></i>
          <span class="tlabel">ACTIVITY // MAIL</span>
        </div>
        <div class="tbody">
          <p style="color:var(--ink-faint);font-size:11.5px;margin-top:0">
            inbound mail to <span class="accent">info@pilserlabs.com</span> is
            logged here and forwarded to your inbox via Cloudflare Email Routing —
            free. Contact-form submissions are logged with their delivery status.
          </p>
          <div id="inbox" style="display:grid;gap:10px"></div>
          <div id="inboxState" class="notice" hidden></div>
        </div>
      </div>
    </div>
  </main>
</Base>

<style>
  .agent-keyrow {
    display: flex;
    gap: 8px;
  }
  .agent-keyrow input {
    flex: 1;
  }
  .agent-keyrow .btn {
    padding: 10px 14px;
    white-space: nowrap;
  }
  .filterbar {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }
  .chips {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .chip {
    font-family: var(--mono);
    font-size: 11.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 6px 12px;
    border: 1px solid var(--line-2);
    color: var(--ink-dim);
    background: transparent;
    cursor: pointer;
    transition: all 0.18s;
  }
  .chip.on {
    border-color: var(--neon);
    color: var(--neon);
    background: rgba(62, 224, 255, 0.08);
    box-shadow: var(--glow-soft);
  }
  .badge {
    display: inline-block;
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 2px 7px;
    border: 1px solid var(--line-2);
    color: var(--ink-dim);
    margin-left: 8px;
  }
  .badge.k-project {
    border-color: rgba(0, 217, 255, 0.6);
    color: var(--cyan);
  }
  .badge.k-paper {
    border-color: rgba(255, 194, 75, 0.6);
    color: var(--amber);
  }
  .badge.st-draft {
    border-color: rgba(255, 255, 255, 0.2);
    color: var(--ink-faint);
  }
  .badge.st-archived {
    border-color: rgba(255, 77, 109, 0.6);
    color: var(--rose);
  }
  .badge.st-ok {
    border-color: rgba(58, 245, 196, 0.6);
    color: var(--teal, #3af5c4);
  }
  .badge.st-err {
    border-color: rgba(255, 77, 109, 0.6);
    color: var(--rose);
  }
  .badge.st-mid {
    border-color: rgba(255, 194, 75, 0.6);
    color: var(--amber);
  }
  .entry-row .name {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .entry-thumb {
    width: 64px;
    height: 36px;
    object-fit: cover;
    border: 1px solid var(--line-2);
    border-radius: 2px;
    flex-shrink: 0;
  }
  .entry-thumb.none {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 9px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-faint);
    background: var(--bg-2);
  }
</style>

<script>
  const byId = (id: string): any => document.getElementById(id);
  const api = async (url: string, init?: RequestInit): Promise<any> => {
    const res = await fetch(url, init);
    let data = null;
    try {
      data = await res.json();
    } catch {
      /* noop */
    }
    return { ok: res.ok, status: res.status, data };
  };

  let AGENT = { key: '', guide: '' };
  let FEED: any[] = [];
  let filter = 'all';
  let search = '';

  const esc = (str: any): string => String(str ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));

  function state(msg: string, isErr = false) {
    const el = byId('formState');
    el.hidden = false;
    el.textContent = msg;
    el.classList.toggle('err', isErr);
  }

  function listState(msg: string | null, isErr = false) {
    const el = byId('listState');
    if (msg === null) {
      el.hidden = true;
      return;
    }
    el.hidden = false;
    el.textContent = msg;
    el.classList.toggle('err', isErr);
  }

  async function bootstrap() {
    const a = await api('/api/auth');
    showGate(!a.data?.admin);
    if (a.data?.admin) {
      const ag = await api('/api/auth?action=agent');
      AGENT.key = ag.data?.agentKey ?? '';
      AGENT.guide = ag.data?.guide ?? '';
      byId('agentKey').value = AGENT.key;
      loadInbox();
      loadMailConfig();
      loadEntries();
    }
  }

  function showGate(on: boolean) {
    byId('gate').hidden = !on;
    byId('console').hidden = on;
  }

  async function login() {
    const pw = byId('pw').value;
    const r = await api('/api/auth', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ action: 'login', password: pw }),
    });
    if (!r.ok) {
      const e = byId('gateErr');
      e.hidden = false;
      e.textContent = r.data?.error ?? 'access denied';
      return;
    }
    showGate(false);
    const ag = await api('/api/auth?action=agent');
    AGENT.key = ag.data?.agentKey ?? '';
    loadInbox();
    loadMailConfig();
    loadInbox();
    byId('agentKey').value = AGENT.key;
    loadEntries();
  }

  async function loadEntries() {
    const r = await api('/api/dists?action=feed');
    FEED = Array.isArray(r.data?.feed) ? r.data.feed : [];
    renderFilters();
    renderList();
    listState(FEED.length === 0 ? 'Registry is empty — create the first module.' : null);
  }

  function renderFilters() {
    const kinds = ['all', 'experiment', 'project', 'paper'];
    byId('filterChips').innerHTML = kinds
      .map((k) => `<button class="chip${filter === k ? ' on' : ''}" data-k="${k}">${k}</button>`)
      .join('');
    byId('filterChips').querySelectorAll('.chip').forEach((c: HTMLElement) => {
      c.addEventListener('click', () => {
        filter = c.dataset.k || 'all';
        renderFilters();
        renderList();
      });
    });
  }

  function visible() {
    const q = search.toLowerCase();
    return FEED.filter((e) => {
      if (filter !== 'all' && e.kind !== filter) return false;
      if (!q) return true;
      return `${e.slug} ${e.title} ${(e.tags || []).join(' ')}`.toLowerCase().includes(q);
    });
  }

  function renderList() {
    const list = byId('entries');
    const items = visible();
    list.innerHTML = '';
    if (items.length === 0) {
      listState('No modules match.', false);
      return;
    }
    listState(null);
    items.forEach((e: any) => {
      const colors = (e.theme?.colors ?? []).map((c: string) => `<i style="background:${c}"></i>`).join('');
      const kindBadge = e.kind === 'project' ? 'k-project' : e.kind === 'paper' ? 'k-paper' : '';
      const stBadge = e.status === 'draft' ? 'st-draft' : e.status === 'archived' ? 'st-archived' : '';
      const banner = e.seo?.ogImage
        ? `<img class="entry-thumb" src="${esc(e.seo.ogImage.startsWith('/') ? `/p/${e.slug}${e.seo.ogImage}` : e.seo.ogImage)}" alt="" loading="lazy" />`
        : `<span class="entry-thumb none">no banner</span>`;
      const row = document.createElement('div');
      row.className = 'entry-row';
      row.innerHTML = `
        <div class="meta">
          ${banner}
          <div class="swatch">${colors}</div>
          <div>
            <div class="name">${esc(e.title)}<span class="badge ${kindBadge}">${esc(e.kind)}</span><span class="badge ${stBadge}">${esc(e.status)}</span></div>
            <div class="slug">/${esc(e.slug)}/ · ${(e.tags || []).join(', ')}</div>
          </div>
        </div>
        <div class="ops">
          <button class="btn btn-soft" data-open="/view/${esc(e.slug)}/">open</button>
          <button class="btn btn-soft" data-edit="${esc(e.slug)}">edit</button>
          <button class="btn btn-danger" data-del="${esc(e.slug)}">delete</button>
        </div>`;
      row.querySelector('[data-open]')!.addEventListener('click', () => window.open(`/view/${e.slug}/`, '_blank'));
      row.querySelector('[data-edit]')!.addEventListener('click', () => fillForm(e.slug));
      row.querySelector('[data-del]')!.addEventListener('click', () => removeEntry(e.slug, e.title));
      list.appendChild(row);
    });
  }

  async function fillForm(slug: string) {
    const r = await api(`/api/dists?slug=${encodeURIComponent(slug)}`);
    if (!r.ok || !r.data?.entry) return;
    const e = r.data.entry;
    byId('f_slug').value = e.slug;
    byId('f_kind').value = e.kind ?? 'experiment';
    byId('f_status').value = e.status ?? 'live';
    byId('f_title').value = e.title;
    byId('f_desc').value = e.description ?? '';
    byId('f_tags').value = (e.tags ?? []).join(', ');
    byId('f_btnLabel').value = e.button?.label ?? '';
    byId('f_btnDesign').value = e.button?.design ?? 'minimal';
    byId('f_theme').value = JSON.stringify(e.theme?.colors ?? []);
    themePreview(e.theme?.colors ?? []);
    byId('f_seoTitle').value = e.seo?.title ?? '';
    byId('f_seoDesc').value = e.seo?.description ?? '';
    byId('f_seoKeywords').value = e.seo?.keywords ?? '';
    byId('f_seoIndex')?.checked !== undefined && (byId('f_seoIndex')!.checked = e.seo?.robotsIndex !== false);
    byId('f_bannerUrl').value = /^https?:\/\//i.test(e.seo?.ogImage ?? '') ? e.seo.ogImage : '';
    byId('f_clearBanner').checked = false;
    byId('f_bannerFile').value = '';
    byId('f_file').value = '';
    byId('bannerCur').textContent = e.seo?.ogImage ? `banner: ${e.seo.ogImage}` : 'no banner set';
    const bp = byId('bannerPreview');
    const bw = byId('bannerPreviewWrap');
    if (e.seo?.ogImage) {
      bp.src = e.seo.ogImage.startsWith('/') ? `/p/${e.slug}${e.seo.ogImage}` : e.seo.ogImage;
      bw.hidden = false;
    } else {
      bw.hidden = true;
    }
    byId('editMode').hidden = false;
    byId('editMode').textContent = `editing /${e.slug}/`;
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  async function removeEntry(slug: string, title: string) {
    if (!confirm(`Delete "${title}" (/p/${slug}/)? Dist, banner and SEO are removed.`)) return;
    const r = await fetch('/api/dists', {
      method: 'DELETE',
      headers: { 'content-type': 'application/x-www-form-urlencoded' },
      body: `slug=${encodeURIComponent(slug)}`,
    });
    if (r.ok) loadEntries();
    else state('delete failed', true);
  }

  function themePreview(colors: string[]) {
    const box = byId('themePreview');
    box.hidden = colors.length === 0;
    box.innerHTML = colors.map((c) => `<i style="background:${/^#[0-9a-f]{6}$/i.test(c) ? c : '#999'}"></i>`).join('');
  }

  function copyGuide() {
    const text = `PILSERLABS — AGENT ACCESS\nKEY: ${AGENT.key}\n\n${AGENT.guide}`;
    navigator.clipboard
      .writeText(text)
      .then(() => state('agent guide + key copied — hand it to the agent.', false))
      .catch(() => state('copy failed — select the key manually.', true));
  }

  function setupDrag() {
    const dz = byId('dz');
    const file = byId('f_file') as HTMLInputElement;
    dz.addEventListener('click', () => file.click());
    dz.addEventListener('keydown', (ev: KeyboardEvent) => {
      if (ev.key === 'Enter' || ev.key === ' ') file.click();
    });
    ['dragenter', 'dragover'].forEach((ev: string) =>
      dz.addEventListener(ev, (e: DragEvent) => {
        e.preventDefault();
        dz.classList.add('drag');
      }),
    );
    ['dragleave', 'drop'].forEach((ev: string) =>
      dz.addEventListener(ev, (e: DragEvent) => {
        e.preventDefault();
        dz.classList.remove('drag');
      }),
    );
    dz.addEventListener('drop', (e: DragEvent) => {
      const dt = e.dataTransfer;
      if (dt?.files.length) file.files = dt.files;
      fileLabel();
    });
    file.addEventListener('change', fileLabel);
    function fileLabel() {
      const f = file.files?.[0];
      byId('dzLabel').textContent = f ? `${f.name} (${Math.round(f.size / 1024)}KB) — ready` : 'drop the dist zip here, or click to browse';
    }
    byId('f_theme').addEventListener('input', () => {
      try {
        const a = JSON.parse(byId('f_theme').value);
        if (Array.isArray(a)) themePreview(a);
      } catch {
        themePreview([]);
      }
    });
  }

  function statusBadge(s: string): string {
    const cls =
      s === 'forwarded' || s === 'email-sent' || s === 'delivered'
        ? 'st-ok'
        : s === 'email-failed' || s === 'failed'
          ? 'st-err'
          : 'st-mid';
    return `<span class="badge ${cls}">${esc(s)}</span>`;
  }

  async function loadInbox() {
    const r = await api('/api/activity');
    const box = byId('inbox');
    const st = byId('inboxState');
    if (!r.ok || !Array.isArray(r.data?.activity)) {
      st.hidden = false;
      st.textContent = 'activity log unavailable';
      return;
    }
    const rows = r.data.activity;
    box.innerHTML = '';
    if (rows.length === 0) {
      st.hidden = false;
      st.textContent = 'no mail activity yet — email info@pilserlabs.com to test';
      return;
    }
    st.hidden = true;
    rows.slice(0, 50).forEach((c: any) => {
      const dir = c.direction === 'in' ? 'IN' : 'OUT';
      const el = document.createElement('div');
      el.className = 'entry-row';
      el.style.flexDirection = 'column';
      el.style.alignItems = 'stretch';
      el.innerHTML = `
        <div style="display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;align-items:center">
          <span style="font-weight:600">
            <span class="badge" style="color:var(--neon);border-color:rgba(62,224,255,.5)">${dir}</span>
            ${esc(c.from_addr || '—')} → ${esc(c.to_addr || '—')}
          </span>
          <span class="slug">${esc(c.created_at)} ${statusBadge(c.status)}</span>
        </div>
        ${c.subject ? `<div style="color:var(--ink);font-size:13px;margin-top:4px">${esc(c.subject)}</div>` : ''}
        ${c.body ? `<div style="color:var(--ink-dim);font-size:12.5px;margin-top:2px;white-space:pre-wrap;max-height:64px;overflow:auto">${esc(c.body)}</div>` : ''}`;
      box.appendChild(el);
    });
  }

  function mailUIVisibility() {
    const p = byId('m_provider').value;
    byId('m_api').hidden = p !== 'api';
    byId('m_apiFromWrap').hidden = p !== 'api';
    byId('m_smtp').hidden = p !== 'smtp';
    byId('m_smtp2').hidden = p !== 'smtp';
    byId('m_smtpSecureWrap').hidden = p !== 'smtp';
  }

  async function loadMailConfig() {
    const r = await api('/api/mailconfig');
    if (!r.ok || !r.data?.configured || !r.data?.config) {
      byId('mStatus').textContent = 'no external mail server configured';
      mailUIVisibility();
      return;
    }
    const c = r.data.config;
    byId('m_provider').value = c.provider || 'none';
    byId('m_apiUrl').value = c.apiUrl || '';
    byId('m_apiKey').value = '';
    byId('m_apiFrom').value = c.apiFrom || '';
    byId('m_from').value = c.fromEmail || '';
    byId('m_to').value = c.toEmail || '';
    byId('m_smtpHost').value = c.smtpHost || '';
    byId('m_smtpPort').value = c.smtpPort ? String(c.smtpPort) : '';
    byId('m_smtpUser').value = c.smtpUser || '';
    byId('m_smtpPass').value = '';
    byId('m_smtpSecure').checked = !!c.smtpSecure;
    byId('mStatus').textContent = `configured · ${c.provider}`;
    mailUIVisibility();
  }

  function bindMail() {
    byId('m_provider').addEventListener('change', mailUIVisibility);
    byId('mSave').addEventListener('click', async () => {
      const body: any = {
        provider: byId('m_provider').value,
        apiUrl: byId('m_apiUrl').value.trim(),
        apiKey: byId('m_apiKey').value.trim(),
        apiFrom: byId('m_apiFrom').value.trim(),
        fromEmail: byId('m_from').value.trim(),
        toEmail: byId('m_to').value.trim(),
        smtpHost: byId('m_smtpHost').value.trim(),
        smtpPort: Number(byId('m_smtpPort').value) || undefined,
        smtpUser: byId('m_smtpUser').value.trim(),
        smtpPass: byId('m_smtpPass').value.trim(),
        smtpSecure: byId('m_smtpSecure').checked,
      };
      const res = await fetch('/api/mailconfig', {
        method: 'POST',
        credentials: 'include',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(body),
      });
      const data: any = await res.json().catch(() => null);
      byId('mStatus').textContent = res.ok ? 'saved' : (data?.error ?? 'save failed');
      byId('mStatus').style.color = res.ok ? 'var(--neon)' : 'var(--rose)';
      if (res.ok) loadMailConfig();
    });
    byId('mClear').addEventListener('click', async () => {
      const res = await fetch('/api/mailconfig', { method: 'DELETE', credentials: 'include' });
      byId('mStatus').textContent = res.ok ? 'disabled' : 'clear failed';
      byId('mStatus').style.color = res.ok ? 'var(--ink-dim)' : 'var(--rose)';
      if (res.ok) loadMailConfig();
    });
  }

  function bindForm() {
    byId('regForm').addEventListener('submit', async (ev: Event) => {
      ev.preventDefault();
      const fd = new FormData(byId('regForm'));
      const file = (byId('f_file') as HTMLInputElement).files?.[0];
      const banner = (byId('f_bannerFile') as HTMLInputElement).files?.[0];
      const slug = byId('f_slug').value.trim().toLowerCase();
      const isNew = !FEED.some((e) => e.slug === slug);
      if (isNew && !file) {
        state('a dist zip is required to create a new module', true);
        return;
      }
      fd.set('seoIndex', byId('f_seoIndex') ? (byId('f_seoIndex').checked ? 'true' : 'false') : 'true');
      fd.set('clearBanner', byId('f_clearBanner').checked ? 'true' : 'false');
      if (banner) fd.set('bannerFile', banner);
      if (file) fd.set('file', file);
      const btn = byId('submitBtn');
      btn.disabled = true;
      const res = await fetch('/api/dists', { method: 'POST', credentials: 'include', body: fd });
      btn.disabled = false;
      const data: any = await res.json().catch(() => null);
      if (res.ok) {
        state(`module /${data?.entry?.slug}/ ${res.status === 201 ? 'created' : 'updated'} — ${file ? 'dist replaced.' : 'metadata saved.'}`);
        byId('editMode').hidden = true;
        if (data?.entry?.seo?.ogImage) {
          byId('bannerPreview').src = data.entry.seo.ogImage.startsWith('/') ? `/p/${data.entry.slug}${data.entry.seo.ogImage}` : data.entry.seo.ogImage;
          byId('bannerPreviewWrap').hidden = false;
          byId('bannerCur').textContent = `banner: ${data.entry.seo.ogImage}`;
        }
        loadEntries();
      } else {
        state(data?.error ?? 'operation failed', true);
      }
    });
    byId('resetBtn').addEventListener('click', () => {
      byId('regForm').reset();
      byId('formState').hidden = true;
      byId('editMode').hidden = true;
      themePreview([]);
      byId('bannerCur').textContent = 'no banner set';
      byId('dzLabel').textContent = 'drop the dist zip here, or click to browse';
    });
    byId('searchBox').addEventListener('input', (ev: Event) => {
      search = (ev.target as HTMLInputElement).value.trim();
      renderList();
    });
    byId('toggleKey').addEventListener('click', () => {
      const k = byId('agentKey');
      const show = k.type === 'password';
      k.type = show ? 'text' : 'password';
      byId('toggleKey').textContent = show ? 'hide' : 'reveal';
    });
    byId('copyGuide').addEventListener('click', copyGuide);
  }

  byId('pw').addEventListener('keydown', (ev: KeyboardEvent) => {
    if (ev.key === 'Enter') login();
  });
  byId('unlock').addEventListener('click', login);
  bindMail();
  bindForm();
  setupDrag();
  bootstrap();
</script>