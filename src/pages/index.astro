---
import Base from '../layouts/Base.astro';
import FeedCard from '../components/FeedCard.astro';
import SysPanel from '../components/SysPanel.astro';
import site from '../data/pilseros.json';
import { useEnv } from '../lib/env';
import { listFeed } from '../lib/registry';

export const prerender = false;

const env = useEnv();
const feed = (await listFeed(env)).filter(
  (e) => e.status === 'live' && e.kind !== 'project',
);

const tickerParts = feed.length > 0
  ? [...feed.map((e) => `#${e.title}`), ...site.ticker]
  : site.ticker;

const liveCount = feed.length;
const artifactCount = feed.reduce((acc, e) => acc + e.files.length, 0);

const statValues: Record<string, string> = {
  experiments: String(liveCount).padStart(2, '0'),
  artifacts: String(artifactCount).padStart(3, '0'),
  apis: '04',
  uptime: '100%',
};
---

<Base title={site.meta.defaultTitle} description={site.meta.description} activeTab="feed">
  <main>
    <section class="hero">
      <div class="width hero-inner">
        <div>
          <div class="kicker">
            <span class="led blink"></span>
            <span class="mono-label">{site.hero.kicker}</span>
          </div>
          <h1 class="flicker">
            {site.hero.title.map((part) =>
              part.class === 'neon' ? <span class="neon">{part.text}</span> : part.text,
            )}
          </h1>
          <p class="sub" set:html={site.hero.subtitle}></p>
          <div class="cta">
            {site.hero.cta.map((c) => (
              <a class={`btn ${c.variant === 'neon' ? 'btn-neon' : 'btn-ghost'}`} href={c.href}>
                {c.label}
              </a>
            ))}
          </div>
        </div>
        <SysPanel />
      </div>

      <div class="stats-strip width">
        {site.stats.map((s) => (
          <div class="stat">
            <span class="v" id={`st-${s.id}`} style={s.accent ? 'color:var(--neon)' : ''}>
              {statValues[s.id]}
            </span>
            <span class="k">{s.key}</span>
          </div>
        ))}
      </div>

      <div class="ticker-wrap" aria-hidden="true">
        <div class="ticker-strip">
          <div class="seg">{tickerParts.map((t) => <span>{t}</span>)}</div>
          <div class="seg" aria-hidden="true">{tickerParts.map((t) => <span>{t}</span>)}</div>
        </div>
      </div>
    </section>

    <section class="feed width" id="feed">
      <div class="feed-head">
        <h2 class="mono-label">{site.feed.heading}</h2>
        <span class="count">{String(liveCount).padStart(2, '0')} {site.feed.count}</span>
      </div>

      {liveCount === 0 ? (
        <div class="notice">{site.feed.empty}</div>
      ) : (
        <div class="grid">
          {feed.map((entry) => <FeedCard entry={entry} />)}
        </div>
      )}
    </section>

    <section class="about width">
      <div class="about-grid">
        {site.about.map((cell) => (
          <div class="cell">
            <h3>{cell.id} · {cell.title}</h3>
            {cell.body ? <p set:html={cell.body}></p> : null}
            {cell.specs ? (
              <div class="spec">
                {cell.specs.map((sp) => (
                  <span><b>{sp.label}</b> — {sp.text}</span>
                ))}
              </div>
            ) : null}
          </div>
        ))}
      </div>
    </section>
  </main>
</Base>

<script>
  const stCount = document.getElementById('st-experiments');
  if (stCount) {
    fetch('/api/dists?action=feed')
      .then((r) => r.json())
      .then((d: any) => {
        if (Array.isArray(d?.feed)) stCount.textContent = String(d.feed.length).padStart(2, '0');
      })
      .catch(() => {});
  }
</script>