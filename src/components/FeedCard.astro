---
import type { RegistryEntry } from '../lib/types';

interface Props {
  entry: RegistryEntry;
}

const { entry } = Astro.props;
const c = entry.theme.colors;
const c0 = c[0] ?? '#c9ff3d';
const c1 = c[1] ?? '#3af5c4';
const c2 = c[2] ?? '#ffb000';
const slug = entry.slug;
---

<article class="card" style={`--c0:${c0};--c1:${c1};--c2:${c2}`}>
  <div class="topline">
    <span>experiment <span class="experiment-id">#{String(entry.createdAt % 100000).padStart(6, '0')}</span></span>
    <span class="status-dot" title="online"></span>
  </div>
  <h3>{entry.title}</h3>
  <p class="desc">{entry.description}</p>
  {entry.tags.length > 0 && (
    <div class="tags">
      {entry.tags.map((t) => (
        <span class="tag">{t}</span>
      ))}
    </div>
  )}
  <div class="bootline">→ boot log: loaded {entry.files.length} artifacts</div>
  <a
    class={`btn btn-design-${entry.button.design}`}
    href={`/p/${slug}/`}
    target="_blank"
  >
    {entry.button.label}
  </a>
</article>