---
import type { RegistryEntry } from '../lib/types';

interface Props {
  entry: RegistryEntry;
}

const { entry } = Astro.props;
const c = entry.theme.colors;
const c0 = c[0] ?? '#3ee0ff';
const c1 = c[1] ?? '#00d9ff';
const c2 = c[2] ?? '#ffc24b';
const slug = entry.slug;
const expId = String(entry.createdAt % 100000).padStart(6, '0');
---

<article class="card" style={`--c0:${c0};--c1:${c1};--c2:${c2}`}>
  <div class="topline">
    <span>
      <span class="led blink" style={`background:${c0};box-shadow:0 0 9px ${c0}`}></span>
      module <span class="experiment-id">#{expId}</span>
    </span>
    <span class="top-right">
    <span class="mono-label">status: live</span>
    <a
      class="card-out"
      href={`/p/${slug}/`}
      target="_blank"
      rel="noopener"
      data-track="module_standalone"
      data-track-label={entry.title}
      data-track-id={slug}
      title="open full page in a new tab"
      aria-label={`Open ${entry.title} as a full page in a new tab`}
    >
      <svg width="11" height="11" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M6.5 2.5h7v7M3.5 12.5l10-10" stroke="currentColor" stroke-width="1.5" />
      </svg>
    </a>
  </span>
</div>
  {entry.seo.ogImage && (
    <div class="card-banner" style={`--c0:${c0}`}>
      <img
        src={entry.seo.ogImage.startsWith('/') ? `/p/${slug}${entry.seo.ogImage}` : entry.seo.ogImage}
        alt={entry.title}
        loading="lazy"
      />
    </div>
  )}
  <h3>{entry.title}</h3>
  <p class="desc">{entry.description}</p>
  {entry.tags.length > 0 && (
    <div class="tags">
      {entry.tags.map((t) => (
        <span class="tag">{t}</span>
      ))}
    </div>
  )}
  <div class="data-row">
    <span>artifacts served</span>
    <b>{String(entry.files.length).padStart(3, '0')}</b>
  </div>
  <div class="data-row">
    <span>route · <span class="experiment-id">/view/{slug}/</span></span>
    <b>live</b>
  </div>
  <a
    class={`btn btn-design-${entry.button.design} stretch`}
    href={`/view/${slug}/`}
    aria-label={`Open ${entry.title}`}
    data-track="module_open"
    data-track-label={entry.title}
    data-track-id={slug}
  >
    {entry.button.label}
  </a>
</article>