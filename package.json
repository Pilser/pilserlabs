{
  "name": "pilserlabs",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate": "bun scripts/generate-pilseros.mjs",
    "predev": "bun scripts/generate-pilseros.mjs",
    "dev": "astro dev",
    "check": "astro check",
    "test": "bun test",
    "prebuild": "bun scripts/generate-pilseros.mjs",
    "build": "astro build",
    "preview": "bun run build && wrangler dev",
    "deploy": "bun run build && wrangler deploy",
    "deploy:api": "bun scripts/deploy.mjs",
    "db:schema": "wrangler d1 execute pilserlabs-d1 --remote --file=d1/schema.sql",
    "db:schema:local": "wrangler d1 execute pilserlabs-d1 --local --file=d1/schema.sql",
    "tx": "wrangler types"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.1",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "astro": "^7.2.1",
    "fflate": "^0.8.3",
    "js-yaml": "^5.2.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260812.1",
    "bun-types": "^1.3.14",
    "typescript": "^6",
    "wrangler": "^4.121.0"
  }
}